 void
+nouveau_fence_list_free_bos(struct nouveau_fence_list *fence_list)
+{
+   while (fence_list->n_free_bo)
+      nouveau_bo_ref(NULL, &fence_list->free_bo[--fence_list->n_free_bo]);
+}
